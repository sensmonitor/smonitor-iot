# Waveshare ESP32-S3-A7670E-4G board profile
# Set the DIP switches on the back to "4G ON" and "USB OFF" before flashing.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_SMONITOR_BOARD_GENERIC_ESP32_UART=y

# ESP32-S3R8: 16 MB flash and 8 MB Octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# SIM7670 compatibility profile used with the A7670E modem.
# This is not a dedicated A7670 driver; GNSS and 2G support are not validated.
CONFIG_SMONITOR_MODEM_PROFILE_SIM7670=y
CONFIG_SMONITOR_MODEM_NETWORK_LTE=y

# Modem UART is routed on the board. The modem is powered by the 4G DIP switch,
# so the firmware does not toggle a PWRKEY pin.
CONFIG_SMONITOR_BOARD_MODEM_UART_TX_PIN=18
CONFIG_SMONITOR_BOARD_MODEM_UART_RX_PIN=17
CONFIG_SMONITOR_BOARD_MODEM_UART_RTS_PIN=-1
CONFIG_SMONITOR_BOARD_MODEM_UART_CTS_PIN=-1
CONFIG_SMONITOR_BOARD_MODEM_UART_BAUD_RATE=115200
CONFIG_SMONITOR_BOARD_MODEM_UART_RX_BUFFER_SIZE=4096
CONFIG_SMONITOR_BOARD_MODEM_UART_TX_BUFFER_SIZE=2048
CONFIG_SMONITOR_BOARD_MODEM_POWER_EXTERNAL=y

# The board has no dedicated sensor connector. Set CONFIG_SMONITOR_I2C_SDA_PIN
# and CONFIG_SMONITOR_I2C_SCL_PIN in sdkconfig.defaults.local to the free header
# GPIOs you wired. The generic default SCL pin (GPIO 22) does not exist on ESP32-S3.
