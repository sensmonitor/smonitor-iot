# Custom ESP32-S3 + UART modem configuration
CONFIG_IDF_TARGET="esp32s3"
CONFIG_SMONITOR_BOARD_GENERIC_ESP32_UART=y

# N8R8: 8 MB flash and 8 MB Octal PSRAM at 80 MHz.
# CONFIG_ESPTOOLPY_FLASHSIZE_16MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=y

# Battery monitoring disabled for this custom board.
# CONFIG_SMONITOR_BATTERY_ENABLE is not set

# SIM7670 compatibility profile used with the A7670E HAT.
# This is not a dedicated A7670 driver; GNSS and 2G support are not validated.
CONFIG_SMONITOR_MODEM_PROFILE_SIM7670=y
CONFIG_SMONITOR_MODEM_NETWORK_LTE=y

# Modem UART wiring; adjust for the custom board.
CONFIG_SMONITOR_BOARD_MODEM_UART_TX_PIN=4
CONFIG_SMONITOR_BOARD_MODEM_UART_RX_PIN=5
CONFIG_SMONITOR_BOARD_MODEM_UART_RTS_PIN=-1
CONFIG_SMONITOR_BOARD_MODEM_UART_CTS_PIN=-1
CONFIG_SMONITOR_BOARD_MODEM_PWRKEY_PIN=46
CONFIG_SMONITOR_BOARD_MODEM_UART_BAUD_RATE=115200
CONFIG_SMONITOR_BOARD_MODEM_UART_RX_BUFFER_SIZE=4096
CONFIG_SMONITOR_BOARD_MODEM_UART_TX_BUFFER_SIZE=2048

# External sensor I2C wiring for the custom board.
CONFIG_SMONITOR_I2C_PORT=0
CONFIG_SMONITOR_I2C_SDA_PIN=3
CONFIG_SMONITOR_I2C_SCL_PIN=2
CONFIG_SMONITOR_I2C_INTERNAL_PULLUPS=y
CONFIG_SMONITOR_BOARD_MODEM_PWRKEY_ACTIVE_LEVEL=1
CONFIG_SMONITOR_BOARD_MODEM_PWRKEY_PULSE_MS=100
CONFIG_SMONITOR_BOARD_MODEM_POWER_GPIO=y
CONFIG_SMONITOR_BOARD_MODEM_STARTUP_DELAY_MS=10000
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_SPEED_80M=y
